# Copy to .env.local for local dev (Wrangler and the Vite plugin read it).

# Enables the /api/lab/* judge-tuning endpoints and the word:<word> prompt override.
LAB_ENABLED=1

# mock: Drishti makes up judgements for free, with no Clef calls (the local default).
# live: calls the real Clef, from the provider below.
JUDGE_MODE=mock

# Who runs Clef in live mode.
# ollama: a System One API at CLEF_URL. Free and local after `ollama pull clef` (about 19 GB).
# cloudflare: Workers AI, which always runs remotely, even in dev. Billed: about $0.00023 per 4-drawing check.
CLEF_PROVIDER=ollama
CLEF_URL=http://localhost:11434
# Only for a hosted System One endpoint that wants a key.
CLEF_API_KEY=
