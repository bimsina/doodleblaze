# Copy to .env.local for local dev (Wrangler and the Vite plugin read it).

# Enables the /api/lab/* judge-tuning endpoints and the word:<word> prompt override.
LAB_ENABLED=1

# mock: Drishti makes up judgements for free, with no Clef calls (the local default).
# live: calls Clef on Workers AI. Billed: about $0.00023 per 4-drawing check.
JUDGE_MODE=mock
