/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "doodleblaze",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"ai": {
		"binding": "AI"
	},
	"vars": {
		// Every Clef call goes through this AI Gateway (logs, spend analytics, hard limits).
		"AI_GATEWAY": "doodleblaze",
		// Clef requests shared by all rooms. Workers AI allows 300 a minute per account.
		"JUDGE_PER_MINUTE": "240",
		// The gateway logs $0.00007–0.00023 a request, so this stays under its $1/day spend limit:
		// new games pause with the "resting" note before the gateway starts refusing. Resets at midnight UTC.
		"JUDGE_PER_DAY": "2500",
		// "live" calls Clef. "mock" makes up judgements for free (no API calls); .env.local sets it for local dev.
		"JUDGE_MODE": "live",
		"CLEF_PROVIDER": "cloudflare"
	},
	"kv_namespaces": [
		{
			// Put "paused" = "1" here to pause new games by hand, or "kill" = "1" to close every room.
			"binding": "FLAGS",
			"id": "b96cf95168a64c3aafcf9b59634513df"
		}
	],
	"ratelimits": [
		{
			// Room creation per IP, per Cloudflare location.
			"name": "ROOM_CREATE_LIMIT",
			"namespace_id": "7301",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			// Room sockets opened per IP, per Cloudflare location. Every (re)connect is billed; a full room on one Wi-Fi is 8.
			"name": "ROOM_JOIN_LIMIT",
			"namespace_id": "7302",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "Room"
			},
			{
				"name": "BUDGET",
				"class_name": "JudgeBudget"
			}
		]
	},
	"exports": {
		"Room": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"JudgeBudget": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"observability": {
		"enabled": true,
		// Every incoming WebSocket message is a log event (a drawing tab sends ~4 a second), so keep a 10% sample.
		"head_sampling_rate": 0.1
	},
	"upload_source_maps": true,
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "doodleblaze.bimsina.dev",
			"custom_domain": true
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}